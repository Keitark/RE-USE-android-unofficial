#version 450

// Resource smoke test only. This shader does not implement RE-USE inference.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) buffer Samples {
    float values[];
} samples;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index < 1024) samples.values[index] = 2.0 * samples.values[index] + 1.0;
}
